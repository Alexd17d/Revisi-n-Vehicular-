{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run C Project",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "gcc src\\*.c -Iheader -o programa.exe && programa.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}